# The single webhook URL the lead form POSTs to.
# Point this at your Make scenario's "Custom Webhook" trigger URL.
# That Make scenario is responsible for routing the lead into Mailchimp.
# The frontend is destination-agnostic: it only knows this URL.
VITE_LEAD_WEBHOOK_URL=https://hook.example.make.com/your-webhook-id

# Optional: link for the "Schedule a Discovery Call" button on the results page
# (e.g. a Calendly URL). Leave unset to hide the button.
VITE_DISCOVERY_CALL_URL=
