# ---------------------------------------------------------------------------
# LEAD DESTINATION (GoHighLevel)
# The calculator POSTs leads to /api/lead, a Vercel function that forwards them
# to this URL. Paste the "Inbound Webhook" trigger URL from your GHL workflow.
# Server-side only: no VITE_ prefix, so it never ships in the public JS.
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/your-location-id/webhook-trigger/your-trigger-id

# Optional: skip the relay and POST straight from the browser to another
# webhook (e.g. a Make scenario). Leave unset to use /api/lead.
VITE_LEAD_WEBHOOK_URL=

# Optional: link for the "Schedule a Discovery Call" button on the results page
# (e.g. a GHL calendar booking link). Leave unset to hide the button.
VITE_DISCOVERY_CALL_URL=
